# ===== Core =====
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=sqlite:///./data/agent.db

# Fernet key used to encrypt stored credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ===== AI / LLM (optional) =====
# If either key is set, the agent uses that LLM for natural-language intent
# extraction (Anthropic is tried first if both are set). If neither is set, a
# deterministic rule-based NLU fallback is used (fully functional, offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (OpenAI-compatible API, very fast/cheap open-weight models).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== AWS (optional, only needed for AWS features) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ALLOWED_REGIONS=us-east-1,us-east-2,us-west-1,us-west-2,eu-west-1

# ===== Ansible =====
# Path to ansible-playbook binary. If not found, Ansible tasks fail with a
# clear message instead of failing silently.
ANSIBLE_PLAYBOOK_BINARY=ansible-playbook
ANSIBLE_WORKDIR=./data/ansible

# ===== Execution =====
SSH_CONNECT_TIMEOUT_SECONDS=15
COMMAND_TIMEOUT_SECONDS=300
MAX_PARALLEL_SERVER_EXECUTIONS=10

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
